# ─── DATABASE ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL — connection pooler (use in application code)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase direct connection (use ONLY for prisma migrate deploy)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ─── SUPABASE ──────────────────────────────────────────────────────────────────
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."  # Server-side only — never expose to browser

# ─── SHOPIFY ───────────────────────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN="ruckusrenditions.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN="[storefront-api-token]"
SHOPIFY_ADMIN_API_KEY="[admin-api-key]"
SHOPIFY_ADMIN_API_SECRET="[admin-api-secret]"
# Shared secret for HMAC webhook validation
SHOPIFY_WEBHOOK_SECRET="[webhook-secret]"

# ─── SITE ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://ruckusrenditions.com"
# Development: NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── SUPPLIER CREDENTIALS (server-side only) ───────────────────────────────────
# Keystone Automotive
KEYSTONE_API_KEY="[keystone-api-key]"
KEYSTONE_ACCOUNT_NUMBER="[keystone-account-number]"
KEYSTONE_FTP_HOST="ftp.keystoneautomotive.com"
KEYSTONE_FTP_USER="[ftp-username]"
KEYSTONE_FTP_PASS="[ftp-password]"

# Turn 14 Distribution
TURN14_API_KEY="[turn14-api-key]"
TURN14_API_BASE_URL="https://api.turn14.com/v1"

# Meyer Distributing
MEYER_FTP_HOST="ftp.meyerdist.com"
MEYER_FTP_USER="[ftp-username]"
MEYER_FTP_PASS="[ftp-password]"
MEYER_ACCOUNT_NUMBER="[account-number]"

# ─── OPTIONAL (add as needed) ─────────────────────────────────────────────────
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# Sentry error monitoring
SENTRY_DSN="https://[key]@sentry.io/[project]"
# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL="https://[url].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[token]"
